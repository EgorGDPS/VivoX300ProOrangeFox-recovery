#
# BoardConfig for vivo X300 Pro (PD2502 / MT6993)
#

DEVICE_PATH := device/vivo/PD2502

# Architecture
TARGET_ARCH := arm64
TARGET_ARCH_VARIANT := armv9-a
TARGET_CPU_ABI := arm64-v8a
TARGET_CPU_ABI2 :=
TARGET_CPU_VARIANT := generic
TARGET_SUPPORTS_64_BIT_APPS := true
TARGET_SUPPORTS_32_BIT_APPS := false

# Platform
TARGET_BOARD_PLATFORM := mt6993
TARGET_BOOTLOADER_BOARD_NAME := mt6993
BUILD_BROKEN_DUP_RULES := true
BUILD_BROKEN_ELF_PREBUILT_PRODUCT_COPY_FILES := true
BUILD_BROKEN_PREBUILT_ELF_FILES := true
TARGET_NO_CHECK_ELF_FILES := true

# Kernel
TARGET_NO_KERNEL := false
BOARD_KERNEL_PAGESIZE := 4096
BOARD_BOOT_HEADER_VERSION := 4
BOARD_MKBOOTIMG_ARGS := --header_version 4
BOARD_KERNEL_BASE := 0x40078000
BOARD_PAGE_SIZE := 4096

BOARD_KERNEL_CMDLINE := bootopt=64S3,32N2,64N2 product.version=PD2502F_EX_A_16.0.4.3.W20 fingerprint.abbr=16/BP2A.250605.031.A3 region_ver=W20 product.solution=MTK bootconfig
BOARD_BOOTCONFIG_FILE := $(DEVICE_PATH)/prebuilt/bootconfig
BOARD_INCLUDE_DTB_IN_BOOTIMG := true
BOARD_PREBUILT_DTBIMAGE_DIR := $(DEVICE_PATH)/prebuilt
BOARD_PREBUILT_DTB := $(DEVICE_PATH)/prebuilt/dtb.img
TARGET_PREBUILT_KERNEL := $(DEVICE_PATH)/prebuilt/kernel

# Virtual A/B & Vendor Boot Recovery
AB_OTA_UPDATER := true
BOARD_USES_RECOVERY_AS_BOOT := false
BOARD_MOVE_RECOVERY_RESOURCES_TO_VENDOR_BOOT := true
BOARD_INCLUDE_RECOVERY_RAMDISK_IN_VENDOR_BOOT := true
BOARD_RAMDISK_USE_LZ4 := true
BOARD_SUPPRESS_SECURE_ERASE := true

# Partitions Sizes (from device dump)
BOARD_BOOTIMAGE_PARTITION_SIZE := 100663296
BOARD_INIT_BOOT_IMAGE_PARTITION_SIZE := 8388608
BOARD_VENDOR_BOOTIMAGE_PARTITION_SIZE := 134217728
BOARD_DTBOIMG_PARTITION_SIZE := 8388608

# Dynamic Partitions
BOARD_SUPER_PARTITION_SIZE := 22011707392
BOARD_SUPER_PARTITION_GROUPS := main
BOARD_MAIN_SIZE := 22011707392
BOARD_MAIN_PARTITION_LIST := \
    system \
    system_ext \
    vendor \
    product \
    odm \
    vendor_dlkm \
    odm_dlkm \
    system_dlkm \
    cust \
    vgc

# File Systems
TARGET_USERIMAGES_USE_EXT4 := true
TARGET_USERIMAGES_USE_F2FS := true
BOARD_USERDATAIMAGE_FILE_SYSTEM_TYPE := f2fs

# Display & UI Settings
TARGET_SCREEN_WIDTH := 1260
TARGET_SCREEN_HEIGHT := 2800
TARGET_RECOVERY_DENSITY := 520
TARGET_RECOVERY_PIXEL_FORMAT := RGBX_8888
TW_THEME := portrait_hdpi
TW_EXTRA_LANGUAGES := true
TW_DEFAULT_BRIGHTNESS := 6000
TW_MAX_BRIGHTNESS := 15415
TW_BRIGHTNESS_PATH := /sys/class/leds/lcd-backlight/brightness

# OrangeFox Display Geometry & UI Tweaks
OF_SCREEN_H := 2800
OF_STATUS_H := 120
OF_STATUS_INDENT_LEFT := 48
OF_STATUS_INDENT_RIGHT := 48
OF_ALLOW_DISABLE_NAVBAR := 0
OF_USE_GREEN_LED := 0
OF_HIDE_NOTCH := 0

# Recovery Features
TW_USE_TOOLBOX := true
TW_INCLUDE_REPACKTOOLS := true
TW_INCLUDE_RESETPROP := true
TW_EXCLUDE_APEX := true
TW_INPUT_BLACKLIST := hbtp_vm
TW_HAS_MTP := false
TW_NO_USB_STORAGE := true
TW_EXCLUDE_DEFAULT_USB_INIT := true
